# Optional read-only compatibility account. Keys added in /admin are stored separately.
OPENCODE_GO_API_KEY=

# Published container tag. Use latest or a pinned sha-<commit> tag.
IMAGE_TAG=latest

# Required for /admin. Use a strong password and a random secret of at least 32 characters.
WEB_USERNAME=admin
WEB_PASSWORD=
KEY_ENCRYPTION_SECRET=
# Set to 1 only for an intentional emergency recovery with WEB_USERNAME/WEB_PASSWORD
WEB_ADMIN_RECOVERY=0

# Optional service settings.
PORT=3000
FETCH_TIMEOUT_MS=15000
CACHE_TTL_MS=30000
REFRESH_INTERVAL_MS=30000
WARN_PERCENT=60
DANGER_PERCENT=85
DATA_DIR=/data
# OPENCODE_USAGE_URL=https://opencode.ai/zen/go/v1/usage
# OPENCODE_MODEL_TEST_URL=https://opencode.ai/zen/go/v1/chat/completions
# OPENCODE_MODEL_LIST_URL=https://opencode.ai/zen/go/v1/models
# OPENCODE_MODEL_TEST_MODEL=hy3
